# =============================================================================
# Reachy Mini Conversation — environment template
# =============================================================================
# 真实配置请写到 ~/.reachymini/env.json(用户级,不入 git),本文件仅作参考。
# 运行时优先级:env.json > 环境变量 > 默认值。
#
# Windows 下 ~/.reachymini/ 对应 %USERPROFILE%\.reachymini\
# =============================================================================

# ---------- 豆包 LLM (Doubao Ark) ----------
# 申请:https://www.volcengine.com/product/doubao
DOUBAO_LLM_API_KEY=your-ark-api-key
DOUBAO_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_LLM_MODEL=doubao-seed-character-251128

# ---------- 豆包 ASR (WebSocket 流式,决策 6) ----------
# 申请:https://www.volcengine.com/product/asr
DOUBAO_ASR_API_KEY=your-asr-api-key
DOUBAO_ASR_RESOURCE_ID=volc.seedasr.sauc.duration

# ---------- Edge TTS ----------
# voice 列表见 https://speech.microsoft.com/portal/voicegallery
EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural

# ---------- 运行模式 ----------
# pure_sim       —— 仅仿真(默认,无需真机)
# real_plus_sim  —— 真机 + 仿真镜像(需要 USB 真机)
RUN_MODE=pure_sim

# ---------- HF dataset 预下载(决策 16D,play_emotion 用) ----------
# true  = 首次启动时从 HF 下载 emotions library(~100MB)
# false = 跳过,play_emotion 工具不可用
HF_PRELOAD_DATASETS=false

# ---------- 调试 ----------
# 日志级别:DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 注(决策 6/13 变更 2025-09-09):不再使用 FunASR 本地 ASR,
# 豆包 ASR 是云端 WebSocket,不需要本地模型配置。
# 如确需本地 ASR(高级),可加 sherpa-onnx(无 torch,RPi 友好),
# 但 P0/P1+ 默认不集成。
